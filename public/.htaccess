# alignment — Apache / LiteSpeed settings for cPanel hosting (WhoGoHost / Go54)

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. Only uncomment these two lines AFTER your SSL certificate is active
  # (https://yourdomain shows a padlock), otherwise visitors get an error.
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Send mistyped addresses to the home page instead of a server error page.
  # If you install the app in a subfolder (e.g. yourdomain.com/app/), change "/" to "/app/".
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ / [R=302,L]
</IfModule>

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml application/manifest+json
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg

<IfModule mod_headers.c>
  # Built files in /assets have a content hash in their names, so they can be cached for a year
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Always check for a new index.html so updates show up straight away
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Microphone is needed for the voice-note step; camera and location are not used
  Header always set Permissions-Policy "microphone=(self), camera=(), geolocation=()"
</IfModule>

# Hide source-control and config files if they are ever uploaded by mistake
<FilesMatch "^(\.git|\.env|package(-lock)?\.json|vite\.config\.js)">
  Require all denied
</FilesMatch>
